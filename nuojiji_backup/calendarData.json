lUser":"yes","used":false}],"lastRollKey":"2026-09-21|64","lastTickVts":1790009314861,"lastAnchor":null}},{"userId":"__global__","key":"incident_pool_ce2c8eab-8442-4dd9-a131-12dedbdb4142","value":{"generatedAt":1789991465477,"userId":"uid_1789922841773_h210b4p8r","startDateKey":"2026-09-21","days":1,"items":[{"id":"inc_1789991465475_0","tier":1,"category":"luck","valence":"good","requires":{"start":870,"end":1020,"busyLevel":["busy","free"],"locationKind":"work","weather":[]},"weight":25,"headline":"禁书夹页里滑落一张古符文残片","narration":"卡西恩翻动一卷积尘的古籍时，一张对折的羊皮纸残片从书脊间滑落。残片边缘焦黑，上面绘着半截衔尾蛇纹与几个残缺的古如尼文。文字与他家族图章戒指上的图案有微妙的呼应。","effect":{"busyLevel":null,"titleOverride":"","note":"疑似创始人线索"},"aftermath":"接下来两日他会反复比对这段符文的走向。","scene":"","choices":[],"tellUser":"no","used":false},{"id":"inc_1789991465475_1","tier":2,"category":"social","valence":"bad","requires":{"start":780,"end":840,"busyLevel":["light","free"],"locationKind":"outdoor","weather":[]},"weight":30,"headline":"科维斯带来教廷内部的异动消息","narration":"黑湖畔的会面上，科维斯压低声音报告，教廷北欧分支的两名老成员近日频繁通信，绕开了卡西恩的渠道。索伦·瓦莱里乌斯似乎默许了这种越级往来。科维斯说完便沉默地等待指示。","effect":{"busyLevel":"light","titleOverride":"处理教廷内耗","note":"有人越级串联"},"aftermath":"他可能需要动用一次家族猫头鹰急件回应此事。","scene":"黑湖的水面被秋风吹出细碎的银纹，几片枯叶漂在岸边。科维斯站在礁石旁，斗篷被风灌得鼓起，声音低得几乎被水声吞没：「他们绕过了您。索伦先生……没有阻止。」卡西恩没有立刻答话，指尖在戒指的衔尾蛇纹上缓慢摩挲。远处有低年级学生的笑声传来，很快又散了。他终于开口，只说了一句：「把他们的信路，替我记全。」科维斯颔首，转身没入回城堡的石径。","choices":[{"label":"冷处理静观","outcome":"他按兵不动，只令科维斯暗中记录往来信路，等对方先露出破绽。","aftermath":"情报网悄然收紧，暂无正面冲突。","nextDay":null},{"label":"急件敲打父亲","outcome":"他连夜写了一封措辞讲究的急件送往北欧，既是汇报也是警告，代价是暴露了自己对内部的敏感。","aftermath":"父亲回信含糊，父子间的暗流更深了。","nextDay":{"title":"等候北欧回信","busyLevel":"light","span":"morning"}},{"label":"反向设局","outcome":"他不动声色地放出一条假情报，看两名老成员会传给谁，借机揪出串联的核心。","aftermath":"假饵已下，接下来数日需盯紧回音。","nextDay":null}],"tellUser":"no","used":false},{"id":"inc_1789991465475_2","tier":1,"category":"health","valence":"bad","requires":{"start":1320,"end":30,"busyLevel":["busy","free"],"locationKind":"home","weather":[]},"weight":20,"headline":"深夜研究后眼下浮起青影","narration":"有求必应屋的烛火燃到将尽，卡西恩合上炼金笔记时，指尖沾了新墨。铜镜里映出他眼下淡淡的青色，是连日噩梦与筹谋叠加的痕迹。他用冷水净了净手，才熄灯离开。","effect":{"busyLevel":null,"titleOverride":"","note":"睡眠被侵蚀"},"aftermath":"次日晨他会比平时更沉默些。","scene":"","choices":[],"tellUser":"no","used":false},{"id":"inc_1789991465475_3","tier":1,"category":"weather","valence":"neutral","requires":{"start":390,"end":1140,"busyLevel":["free","light"],"locationKind":"any","weather":[]},"weight":15,"headline":"秋日晴空里飘来一缕冷杉气息","narration":"城堡回廊的窗子敞着，晴朗的秋风裹着庭院里冷杉的气味涌进来。卡西恩在窗前驻足片刻，那是他偏爱的味道。远处禁林的树梢已开始泛黄。","effect":{"busyLevel":null,"titleOverride":"","note":"难得的宁静"},"aftermath":"","scene":"","choices":[],"tellUser":"maybe","used":false}],"lastRollKey":null,"lastTickVts":1790009314866,"lastAnchor":null}},{"userId":"__global__","key":"incident_settings","value":{"enabled":true,"style":"delicate","customPrompt":"","presentation":"full","theaterCard":true,"frequency":"low","quietStart":23,"quietEnd":8,"categories":{"health":true,"work":true,"social":true,"weather":true,"mishap":false,"luck":true,"family":true,"money":true},"customCategories":[],"perChar":{},"dislikes":{"health":1,"mishap":1}}},{"userId":"__global__","key":"schedule_invite_79e68b2f-7725-45ba-98e7-b60c3afe8259_enabled","value":false},{"userId":"__global__","key":"schedule_invite_ce2c8eab-8442-4dd9-a131-12dedbdb4142_enabled","value":false},{"userId":"uid_1789808900314_vh4uzsohn","key":"customHolidays","value":{}},{"userId":"uid_1789808900314_vh4uzsohn","key":"enabledCountries","value":["CN"]},{"userId":"uid_1789808900314_vh4uzsohn","key":"events","value":[]},{"userId":"uid_1789808900314_vh4uzsohn","key":"markerimgs","value":[]},{"userId":"uid_1789808900314_vh4uzsohn","key":"markers","value":{}},{"userId":"uid_1789808900314_vh4uzsohn","key":"moods","value":{}},{"userId":"uid_1789808900314_vh4uzsohn","key":"todos","value":[]},{"userId":"uid_1789922841773_h210b4p8r","key":"customHolidays","value":{}},{"userId":"uid_1789922841773_h210b4p8r","key":"enabledCountries","value":["CN"]},{"userId":"ui