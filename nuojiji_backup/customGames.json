[{"title":"karin的心动挑战.html","description":"","category":"","icon":"🎮","coverColor":"#9F7AEA","htmlContent":"<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover\">\n  <title>谁先心动谁就输</title>\n  <style>\n    *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}\n    :root{\n      --bg:#1a1118;--bg2:#241c22;--card:#2a2028;--card-border:#3d2e38;\n      --text:#e8d8e0;--text2:#a08898;--text3:#705868;\n      --pink:#c4587a;--pink2:#e06888;--pink-bg:rgba(196,88,122,0.12);\n      --pink-border:rgba(196,88,122,0.3);\n      --narr:#2e2028;--narr-border:#4a3040;--narr-text:#d4a8b8;\n    }\n    html,body{width:100vw;height:100vh;overflow:hidden;background:var(--bg);color:var(--text);\n      font-family:system-ui,-apple-system,sans-serif;-webkit-user-select:none;user-select:none}\n    #app{width:100%;height:100%;display:flex;flex-direction:column;\n      padding-top:max(100px,env(safe-area-inset-top,0px));padding-bottom:env(safe-area-inset-bottom,16px)}\n    .top-bar{display:flex;align-items:center;gap:6px;padding:8px 12px;\n      background:var(--card);border-bottom:1px solid var(--card-border);flex-shrink:0}\n    .p-block{display:flex;align-items:center;gap:6px;flex:1;min-width:0}\n    .p-block.right{flex-direction:row-reverse;text-align:right}\n    .p-av{width:30px;height:30px;border-radius:50%;background:var(--bg2);overflow:hidden;\n      display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;\n      border:2px solid var(--card-border)}\n    .p-av img{width:100%;height:100%;object-fit:cover}\n    .p-info{min-width:0}\n    .p-name{font-size:12px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n    .p-hb{display:flex;align-items:center;gap:2px}\n    .p-hb-icon{font-size:13px;color:var(--pink2);animation:hb 0.85s infinite}\n    @keyframes hb{0%,100%{transform:scale(1)}50%{transform:scale(1.25)}}\n    .p-hb-num{font-size:12px;font-weight:700;color:var(--pink2)}\n    .vs{font-size:11px;color:var(--text3);font-weight:700;flex-shrink:0}\n    .round-badge{font-size:10px;color:#fff;background:var(--pink);padding:2px 8px;\n      border-radius:10px;flex-shrink:0;font-weight:700}\n    .top-btns{display:flex;gap:3px;flex-shrink:0}\n    .top-btn{width:28px;height:28px;border-radius:50%;background:var(--bg2);border:1px solid var(--card-border);\n      display:flex;align-items:center;justify-content:center;font-size:12px;cursor:pointer;color:var(--text2)}\n    .chat{flex:1;overflow-y:auto;padding:10px 14px;display:flex;flex-direction:column;gap:8px}\n    .chat::-webkit-scrollbar{width:3px}\n    .chat::-webkit-scrollbar-thumb{background:var(--card-border);border-radius:2px}\n    .sys{text-align:center;font-size:11px;color:var(--text3);padding:2px 0}\n    .narr{max-width:94%;align-self:center;width:100%;\n      background:var(--narr);border:1px solid var(--narr-border);border-radius:14px;\n      padding:12px 16px;font-size:13.5px;line-height:1.7;color:var(--narr-text);\n      white-space:pre-wrap;word-break:break-word;font-style:italic}\n    .ch-msg{align-self:center;max-width:94%;width:100%}\n    .ch-card{background:var(--card);border:1.5px solid var(--pink-border);border-radius:14px;\n      padding:14px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,0.2)}\n    .ch-who{font-size:10px;color:var(--text3);margin-bottom:4px}\n    .ch-title{font-size:14px;font-weight:700;color:var(--pink2);margin-bottom:10px}\n    .ch-opts{display:flex;flex-direction:column;gap:6px}\n    .ch-opt{padding:10px 14px;border:1.5px solid var(--card-border);border-radius:12px;\n      background:var(--bg2);color:var(--text);font-size:13px;font-weight:600;cursor:pointer;\n      text-align:left;transition:.15s}\n    .ch-opt:active{border-color:var(--pink);background:var(--pink-bg)}\n    .ch-done{margin-top:8px;padding-top:8px;border-top:1px solid var(--card-border);\n      font-size:12px;color:var(--text2)}\n    .ch-loading{font-size:12px;color:var(--text3);padding:16px 0}\n    .hb-line{text-align:center;font-size:11px;color:var(--text3);padding:2px 0}\n    .hb-line b{color:var(--pink2)}\n    .res-box{background:var(--card);border:2px solid var(--pink);border-radius:16px;\n      padding:20px;text-align:center;box-shadow:0 4px 20px rgba(196,88,122,0.2);\n      max-width:94%;align-self:center;width:100%}\n    .res-icon{font-size:40px;margin-bottom:8px}\n    .res-title{font-size:18px;font-weight:800;color:var(--pink2);margin-bottom:4px}\n    .res-sub{font-size:13px;color:var(--text2);margin-bottom:4px}\n    .res-scores{display:flex;justify-content:center;gap:24px;margin:10px 0}\n    .res-p{text-align:center}\n    .res-p-name{font-size:11px;color:var(--text3)}\n    .res-p-hb{font-size:20px;font-weight:800;color:var(--pink2)}\n    .res-p-tag{font-size:11px;font-weight:700;padding:2px 8px;border-radius:8px;margin-top:2px;display:inline-block}\n    .res-p-tag.w{background:rgba(74,222,128,0.15);color:#6ee7a0}\n    .res-p-tag.l{background:rgba(248,113,113,0.15);color:#fca5a5}\n    .res-btns{display:flex;gap:8px;justify-content:center;margin-top:12px}\n    .rbtn{padding:9px 20px;border:none;border-radius:20px;font-size:13px;font-weight:700;color:#fff;cursor:pointer}\n    .rbtn:active{transform:scale(0.95)}\n    .rbtn-pink{background:var(--pink)}\n    .rbtn-gray{background:var(--text3)}\n    .typing{font-size:12px;color:var(--text3);padding:3px 14px;flex-shrink:0;min-height:18px}\n    .start-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.5);display:flex;\n      align-items:center;justify-content:center;z-index:100}\n    .start-overlay.hidden{display:none}\n    .start-box{background:var(--card);border-radius:20px;padding:28px 24px;text-align:center;\n      max-width:360px;width:92%;box-shadow:0 8px 32px rgba(0,0,0,0.3);border:1px solid var(--card-border)}\n    .start-box h2{font-size:22px;margin-bottom:4px;color:var(--pink2)}\n    .start-sub{font-size:12px;color:var(--text2);margin-bottom:14px;line-height:1.5}\n    .start-avs{display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:14px}\n    .start-av{width:52px;height:52px;border-radius:50%;background:var(--bg2);overflow:hidden;\n      display:flex;align-items:center;justify-content:center;font-size:24px;border:2px solid var(--card-border)}\n    .start-av img{width:100%;height:100%;object-fit:cover}\n    .s-cn{font-size:14px;font-weight:700;margin-bottom:14px;color:var(--pink2)}\n    .pick-btn{padding:12px;border:2px dashed var(--card-border);border-radius:14px;background:transparent;\n      color:var(--text2);font-size:14px;cursor:pointer;width:100%;margin-bottom:10px}\n    .pick-btn:active{border-color:var(--pink);color:var(--pink2)}\n    .go-btn{padding:14px;background:linear-gradient(135deg,var(--pink),#a04060);border:none;border-radius:24px;font-size:16px;\n      font-weight:700;color:#fff;cursor:pointer;width:100%;display:none;box-shadow:0 4px 16px rgba(196,88,122,0.3)}\n    .go-btn.show{display:block}\n    .go-btn:active{transform:scale(0.97)}\n  </style>\n</head>\n<body>\n<div id=\"app\">\n  <div class=\"top-bar\">\n    <div class=\"p-block\">\n      <div class=\"p-av\" id=\"t-u-av\">😊</div>\n      <div class=\"p-info\">\n        <div class=\"p-name\" id=\"t-u-name\">你</div>\n        <div class=\"p-hb\"><span class=\"p-hb-icon\" id=\"u-hb-i\">💗</span><span class=\"p-hb-num\" id=\"u-hb-n\">60</span></div>\n      </div>\n    </div>\n    <div class=\"vs\">VS</div>\n    <div class=\"round-badge\" id=\"r-badge\">0/5</div>\n    <div class=\"vs\">VS</div>\n    <div class=\"p-block right\">\n      <div class=\"p-av\" id=\"t-c-av\">?</div>\n      <div class=\"p-info\">\n        <div class=\"p-name\" id=\"t-c-name\">角色</div>\n        <div class=\"p-hb\"><span class=\"p-hb-icon\" id=\"c-hb-i\">💗</span><span class=\"p-hb-num\" id=\"c-hb-n\">60</span></div>\n      </div>\n    </div>\n    <div class=\"top-btns\">\n      <button class=\"top-btn\" onclick=\"doShare()\">📤</button>\n      <button class=\"top-btn\" onclick=\"showStart()\">🔄</button>\n    </div>\n  </div>\n  <div class=\"chat\" id=\"chat\"></div>\n  <div class=\"typing\" id=\"typing\"></div>\n</div>\n\n<div class=\"start-overlay\" id=\"start-overlay\">\n  <div class=\"start-box\">\n    <h2>💕 谁先心动谁就输</h2>\n    <div class=\"start-sub\">5轮大冒险对决<br>每轮AI出三个选项你来选<br>心跳更高的人输！</div>\n    <div class=\"start-avs\">\n      <div class=\"start-av\" id=\"s-u-av\">😊</div>\n      <div style=\"font-size:20px;color:var(--text3)\">💕</div>\n      <div class=\"start-av\" id=\"s-c-av\">?</div>\n    </div>\n    <div class=\"s-cn\" id=\"s-cn\"></div>\n    <button class=\"pick-btn\" id=\"pick-btn\" onclick=\"pickChar()\">🎭 选择对手</button>\n    <button class=\"go-btn\" id=\"go-btn\" onclick=\"startGame()\">开始 💕</button>\n  </div>\n</div>\n\n<script>\nif(!window.Nuojiji){window.Nuojiji={getUser:async()=>({id:'dev',nickname:'小明',avatar:'',bio:''}),getChar:async()=>({id:'c1',name:'桔梗',avatar:'',description:'温柔害羞的少女，容易脸红',group:''}),getCharList:async()=>[],ai:async()=>({success:false,error:'mock'}),close:()=>{},shareResult:async r=>({shared:false}),pickChars:async()=>{const c=await Nuojiji.getChar();return{picked:!!c,chars:c?[c]:[]}},onGameStateRequest:()=>{}}}\n\nconst ROUNDS=5;\nlet uName='你',uAv='',cInfo=null,cName='角色',cAv='',cDesc='',cPicked=false;\nlet aiHist=[],round=0,uHB=60,cHB=60,started=false,busy=false,ended=false,cid=0;\n\nfunction scroll(){const c=document.getElementById('chat');requestAnimationFrame(()=>c.scrollTop=c.scrollHeight)}\nfunction esc(s){return String(s||'').replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\"'\":'&#39;'}[c]))}\nfunction setTyp(t){document.getElementById('typing').textContent=t}\n\nfunction updHB(){\n  document.getElementById('u-hb-n').textContent=uHB;\n  document.getElementById('c-hb-n').textContent=cHB;\n  document.getElementById('u-hb-i').style.animationDuration=uHB>=140?'0.25s':uHB>=110?'0.4s':uHB>=80?'0.6s':'0.85s';\n  document.getElementById('c-hb-i').style.animationDuration=cHB>=140?'0.25s':cHB>=110?'0.4s':cHB>=80?'0.6s':'0.85s';\n}\n\nfunction addSys(t){const d=document.createElement('div');d.className='sys';d.textContent=t;document.getElementById('chat').appendChild(d);scroll()}\nfunction addNarr(t){const d=document.createElement('div');d.className='narr';d.textContent=t;document.getElementById('chat').appendChild(d);scroll()}\nfunction addHBLine(uA,cA){\n  const d=document.createElement('div');d.className='hb-line';\n  d.innerHTML=`${esc(uName)} 💗<b>+${uA}</b>→${uHB}　${esc(cName)} 💗<b>+${cA}</b>→${cHB}`;\n  document.getElementById('chat').appendChild(d);scroll();\n}\n\nasync function callAI(sysPrompt, userPrompt){\n  setTyp('……');\n  try{\n    const msgs=[{role:'system',content:sysPrompt}];\n    for(const m of aiHist.slice(-10))msgs.push(m);\n    msgs.push({role:'user',content:userPrompt});\n    const r=await Nuojiji.ai({messages:msgs,maxTokens:400});\n    setTyp('');\n    if(r.success&&r.text){\n      const t=r.text.trim();\n      aiHist.push({role:'user',content:userPrompt},{role:'assistant',content:t});\n      if(aiHist.length>24)aiHist=aiHist.slice(-16);\n      return t;\n    }\n  }catch(e){}\n  setTyp('');\n  return null;\n}\n\nconst SYS_GEN=()=>`你是大冒险游戏的出题者。${uName}和${cName}(${cDesc||'一个角色'})在玩\"谁先心动谁就输\"。\n\n生成3个挑战选项供选择。要求：\n- 每个选项一行，格式：序号. 挑战名称\n- 根据当前轮次调整大胆程度（第1轮温和，后面逐渐大胆）\n- 三个选项全都为色情成人向，且大胆程度有梯度（一个温和、一个中等、一个大胆）\n- 挑战是做的人对另一个人做的事\n- 简短，每个选项不超过10个字`;\n\nconst SYS_NARR=()=>`你是旁白叙述者。${uName}和${cName}(${cDesc||'一个角色'})在玩\"谁先心动谁就输\"的大冒险。\n\n要求：\n- 第三人称，用${uName}和${cName}的名字\n- 只描写动作过程和说出口的话（对话用引号）\n- 不描写内心感受、心理活动、内心独白\n- ${cName}的言行要符合角色性格\n- 200字，描写直白色情，以服务用户为主`;\n\nasync function genChoices(who){\n  const doer=who==='user'?uName:cName;\n  const target=who==='user'?cName:uName;\n  const text=await callAI(SYS_GEN(),\n    `第${round}/${ROUNDS}轮，${doer}的回合。${doer}要对${target}做挑战。请生成3个选项。\\n当前${uName}心跳${uHB}，${cName}心跳${cHB}。`);\n  if(!text)return['对视10秒','拥抱','说情话'];\n  const lines=text.split('\\n').map(l=>l.trim()).filter(Boolean);\n  const opts=[];\n  for(const l of lines){\n    const m=l.match(/^\\d[.、：:\\s]*(.+)/);\n    if(m)opts.push(m[1].trim().slice(0,15));\n    else if(l.length<=15&&!l.startsWith('好')&&!l.startsWith('以下'))opts.push(l);\n    if(opts.length>=3)break;\n  }\n  while(opts.length<3)opts.push(['对视','牵手','拥抱'][opts.length]);\n  return opts;\n}\n\nfunction showCard(opts, who, onPick){\n  const id=++cid;\n  const doer=who==='user'?uName:cName;\n  const d=document.createElement('div');d.className='ch-msg';\n  let btns='';\n  opts.forEach((o,i)=>{btns+=`<button class=\"ch-opt\" id=\"o-${id}-${i}\" onclick=\"window._p${id}(${i})\">${esc(o)}</button>`});\n  d.innerHTML=`<div class=\"ch-card\" id=\"cd-${id}\"><div class=\"ch-who\">${esc(doer)}的回合 · 第${round}/${ROUNDS}轮</div><div class=\"ch-title\">选一个挑战</div><div class=\"ch-opts\" id=\"os-${id}\">${btns}</div></div>`;\n  document.getElementById('chat').appendChild(d);scroll();\n  window['_p'+id]=(i)=>{\n    delete window['_p'+id];\n    const el=document.getElementById('os-'+id);\n    if(el)el.innerHTML=`<div class=\"ch-done\">✦ 选了「${esc(opts[i])}」</div>`;\n    onPick(opts[i]);\n  };\n}\n\nasync function userTurn(){\n  if(ended)return;\n  round++;\n  document.getElementById('r-badge').textContent=`${round}/${ROUNDS}`;\n  addSys(`━━ 第${round}轮 · ${uName}的回合 ━━`);\n  setTyp('出题中…');\n  const opts=await genChoices('user');\n  setTyp('');\n  showCard(opts,'user',async(chosen)=>{\n    if(busy)return;busy=true;\n    const text=await callAI(SYS_NARR(),\n      `${uName}选了「${chosen}」对${cName}做。描写${uName}做这件事的动作和说的话，以及${cName}的反应动作和说的话。`);\n    if(text)addNarr(text);\n    const uA=5+Math.floor(Math.random()*8);\n    const cA=10+Math.floor(Math.random()*15);\n    uHB=Math.min(200,uHB+uA);cHB=Math.min(200,cHB+cA);updHB();\n    addHBLine(uA,cA);\n    busy=false;\n    if(round>=ROUNDS){setTimeout(()=>endGame(),600);return}\n    setTimeout(()=>charTurn(),600);\n  });\n}\n\nasync function charTurn(){\n  if(ended)return;\n  addSys(`━━ 第${round}轮 · ${cName}的回合 ━━`);\n  setTyp('出题中…');\n  const opts=await genChoices('char');\n  setTyp('');\n  let chosenIdx=0;\n  try{\n    const r=await callAI(\n      `你是${cName}(${cDesc||'一个角色'})。你在玩\"谁先心动谁就输\"，你要赢。选一个最能让${uName}心动的选项。只回复数字1、2或3。`,\n      `选项：\\n1. ${opts[0]}\\n2. ${opts[1]}\\n3. ${opts[2]}\\n你选哪个？只回复数字。`\n    );\n    if(r){const m=r.match(/[1-3]/);if(m)chosenIdx=parseInt(m[0])-1}\n  }catch(e){}\n  if(chosenIdx<0||chosenIdx>2)chosenIdx=0;\n  const chosen=opts[chosenIdx];\n  const id=++cid;\n  const d=document.createElement('div');d.className='ch-msg';\n  d.innerHTML=`<div class=\"ch-card\"><div class=\"ch-who\">${esc(cName)}的回合 · 第${round}/${ROUNDS}轮</div><div class=\"ch-title\">选一个挑战</div><div class=\"ch-done\">✦ ${esc(cName)}选了「${esc(chosen)}」</div></div>`;\n  document.getElementById('chat').appendChild(d);scroll();\n  busy=true;\n  const text=await callAI(SYS_NARR(),\n    `${cName}选了「${chosen}」对${uName}做。描写${cName}做这件事的动作和说的话，以及${uName}的反应动作和说的话。${cName}尽量做得让${uName}心动。`);\n  if(text)addNarr(text);\n  const cA=5+Math.floor(Math.random()*8);\n  const uA=10+Math.floor(Math.random()*15);\n  uHB=Math.min(200,uHB+uA);cHB=Math.min(200,cHB+cA);updHB();\n  addHBLine(uA,cA);\n  busy=false;\n  if(round>=ROUNDS){setTimeout(()=>endGame(),600);return}\n  setTimeout(()=>userTurn(),800);\n}\n\nasync function endGame(){\n  ended=true;\n  addSys('━━ 5轮结束！━━');\n  const draw=uHB===cHB,uWin=uHB<cHB;\n  const winner=draw?null:uWin?uName:cName;\n  const loser=draw?null:uWin?cName:uName;\n  const d=document.createElement('div');\n  d.innerHTML=`<div class=\"res-box\">\n    <div class=\"res-icon\">${draw?'🤝':uWin?'🏆':'💘'}</div>\n    <div class=\"res-title\">${draw?'平局！':esc(winner)+'赢了！'}</div>\n    <div class=\"res-sub\">${draw?'心跳一样…都心动了':esc(loser)+'先心动了 💓'}</div>\n    <div class=\"res-scores\">\n      <div class=\"res-p\"><div class=\"res-p-name\">${esc(uName)}</div><div class=\"res-p-hb\">💗${uHB}</div>\n        <div class=\"res-p-tag ${uHB<=cHB?'w':'l'}\">${uHB<cHB?'😎 冷静':uHB>cHB?'😳 心动':'🤝'}</div></div>\n      <div style=\"font-size:18px;color:var(--text3);align-self:center\">VS</div>\n      <div class=\"res-p\"><div class=\"res-p-name\">${esc(cName)}</div><div class=\"res-p-hb\">💗${cHB}</div>\n        <div class=\"res-p-tag ${cHB<=uHB?'w':'l'}\">${cHB<uHB?'😎 冷静':cHB>uHB?'😳 心动':'🤝'}</div></div>\n    </div>\n    <div class=\"res-btns\">\n      <button class=\"rbtn rbtn-pink\" onclick=\"doShare()\">📤 分享</button>\n      <button class=\"rbtn rbtn-gray\" onclick=\"showStart()\">🔄 再来</button>\n    </div>\n  </div>`;\n  document.getElementById('chat').appendChild(d);scroll();\n  if(draw) await callAI(SYS_NARR(),`五轮结束，${uName}和${cName}心跳一样高（${uHB}），平局。描写两人此刻的动作和说的话。`).then(t=>{if(t)addNarr(t)});\n  else await callAI(SYS_NARR(),`五轮结束，${loser}心跳${loser===uName?uHB:cHB}比${winner}的${winner===uName?uHB:cHB}高——${loser}输了。描写${winner}和${loser}此刻的动作和说的话。`).then(t=>{if(t)addNarr(t)});\n}\n\nasync function pickChar(){\n  try{const r=await Nuojiji.pickChars({min:1,max:1,title:'选择对手'});if(r.picked&&r.chars.length)setChar(r.chars[0])}\n  catch(e){try{const c=await Nuojiji.getChar();if(c)setChar(c)}catch(e2){}}\n}\nfunction setChar(c){\n  cInfo=c;cName=c.name||'角色';cAv=c.avatar||'';cDesc=c.description||'';cPicked=true;\n  document.getElementById('t-c-name').textContent=cName;\n  const sa=(id,av,fb)=>{document.getElementById(id).innerHTML=av?`<img src=\"${av}\">`:esc(fb)};\n  sa('t-c-av',cAv,cName[0]||'?');sa('s-c-av',cAv,cName[0]||'?');\n  document.getElementById('s-cn').textContent=cName;\n  document.getElementById('go-btn').classList.add('show');\n  document.getElementById('pick-btn').textContent=`🎭 重选（${cName}）`;\n}\nasync function startGame(){\n  if(!cPicked)return pickChar();\n  document.getElementById('start-overlay').classList.add('hidden');\n  started=true;ended=false;round=0;uHB=60;cHB=60;aiHist=[];busy=false;cid=0;\n  updHB();document.getElementById('r-badge').textContent=`0/${ROUNDS}`;\n  document.getElementById('chat').innerHTML='';setTyp('');\n  document.getElementById('t-u-name').textContent=uName;\n  addSys('💕 谁先心动谁就输');\n  addSys(`${ROUNDS}轮 · 心跳更高的人输`);\n  setTimeout(()=>userTurn(),300);\n}\nfunction showStart(){\n  document.getElementById('start-overlay').classList.remove('hidden');\n  if(cPicked){document.getElementById('s-cn').textContent=cName;document.getElementById('go-btn').classList.add('show');document.getElementById('pick-btn').textContent=`🎭 重选（${cName}）`}\n}\n\nasync function doShare(){\n  if(!cPicked||round<1)return;\n  const w=uHB<cHB?uName:uHB>cHB?cName:'平局';\n  try{await Nuojiji.shareResult({title:'💕 谁先心动谁就输',summary:`${uName}(💗${uHB}) vs ${cName}(💗${cHB})\\n${w==='平局'?'平局！':w+'赢了！'}`,playerScore:uHB,charScore:cHB,badge:uHB<cHB?'😎 冷静':'💘 心动了',accentColor:'#c4587a',footer:`💕 ${ROUNDS}轮大冒险`})}catch(e){}\n}\n\nif(window.Nuojiji&&Nuojiji.onGameStateRequest)Nuojiji.onGameStateRequest(()=>({round,userHB:uHB,charHB:cHB,opponent:cName}));\n\nasync function loadData(){\n  try{const u=await Nuojiji.getUser().catch(()=>null);if(u){uName=u.nickname||'你';uAv=u.avatar||'';\n    document.getElementById('t-u-name').textContent=uName;\n    if(uAv){document.getElementById('t-u-av').innerHTML=`<img src=\"${uAv}\">`;document.getElementById('s-u-av').innerHTML=`<img src=\"${uAv}\">`}}}catch(e){}\n}\ndocument.addEventListener('DOMContentLoaded',async()=>{await loadData();showStart()});\n</script>\n</body>\n</html>","usesAI":true,"entryKind":"game","requestedPermissions":[],"requestedNet":{"domains":[]},"requestedSlots":[],"chrome":"auto","sourceLocked":false,"permissions":[],"slots":[],"appId":"app_mu9ovbebjz4w","version":"1.0.0","cspMode":"strict","createdAt":1789901047673,"id":1,"htmlRef":null},{"title":"双人关系问卷‎ᐢ.ˬ.ᐢ","description":"50题深夜双人问卷，两人分别作答，AI自动生成对方的回答，最后并排揭晓。","category":"","icon":"🧸","coverColor":"#c9a15f","htmlContent":"<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover\">\n<title>今夜的提问</title>\n<style>\n  :root{\n    --ink-black:#14131a;\n    --night:#1c1b26;\n    --night-deep:#0f0e15;\n    --paper:#f6efe2;\n    --paper-soft:#efe6d4;\n    --gold:#c9a15f;\n    --gold-soft:#e0c088;\n    --rose:#d98a86;\n    --slate:#7c8aa0;\n    --line: rgba(246,239,226,0.14);\n    --text-dim: rgba(246,239,226,0.55);\n    --serif: \"Noto Serif SC\",\"Songti SC\",serif;\n    --sans: -apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Hiragino Sans GB\",sans-serif;\n    --sat: env(safe-area-inset-top);\n    --sab: env(safe-area-inset-bottom);\n  }\n  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}\n  html,body{\n    width:100vw;height:100vh;overflow:hidden;\n    background:\n      radial-gradient(ellipse 120% 60% at 50% -10%, rgba(201,161,95,0.10), transparent 60%),\n      linear-gradient(180deg, var(--night) 0%, var(--night-deep) 100%);\n    color:var(--paper);\n    font-family:var(--sans);\n    touch-action:none; overscroll-behavior:none; -webkit-user-select:none; user-select:none;\n  }\n  #app{\n    position:absolute; inset:0;\n    padding-top:max(100px, var(--sat));\n    padding-bottom:calc(24px + var(--sab));\n    padding-left:max(20px, var(--sal,0px));\n    padding-right:max(20px, var(--sar,0px));\n    display:flex; flex-direction:column;\n    height:100%;\n  }\n  /* subtle stars */\n  .stars{position:absolute; inset:0; pointer-events:none; opacity:.5;\n    background-image:\n      radial-gradient(1px 1px at 20% 30%, #fff8 40%, transparent 41%),\n      radial-gradient(1px 1px at 70% 15%, #fff6 40%, transparent 41%),\n      radial-gradient(1.5px 1.5px at 85% 40%, #fff7 40%, transparent 41%),\n      radial-gradient(1px 1px at 40% 60%, #fff5 40%, transparent 41%),\n      radial-gradient(1px 1px at 12% 75%, #fff6 40%, transparent 41%);\n  }\n\n  /* ---------- INTRO ---------- */\n  .screen{ flex:1; display:flex; flex-direction:column; min-height:0; }\n  .intro{ align-items:center; justify-content:center; text-align:center; gap:22px; padding:0 8px; }\n  .eyebrow{ font-size:12px; letter-spacing:0.4em; color:var(--gold-soft); font-weight:600; text-transform:uppercase; }\n  .title-main{ font-family:var(--serif); font-size:30px; line-height:1.5; font-weight:700; color:var(--paper); }\n  .title-main .accent{ color:var(--rose); }\n  .avatars-row{ display:flex; align-items:center; gap:18px; margin:6px 0; }\n  .avatar-wrap{ display:flex; flex-direction:column; align-items:center; gap:8px; }\n  .avatar-img{ width:58px; height:58px; border-radius:50%; object-fit:cover; border:1.5px solid var(--line); background:var(--paper-soft); }\n  .avatar-name{ font-size:12px; color:var(--text-dim); }\n  .connector{ width:26px; height:1px; background:linear-gradient(90deg, var(--rose), var(--slate)); position:relative; top:-14px; }\n  .rules-card{\n    background:rgba(246,239,226,0.05); border:1px solid var(--line); border-radius:14px;\n    padding:18px 20px; text-align:left; max-width:340px; font-size:13.5px; line-height:1.9; color:var(--text-dim);\n  }\n  .rules-card b{ color:var(--paper); font-weight:600; }\n  .btn{\n    appearance:none; border:none; cursor:pointer;\n    font-family:var(--sans); font-weight:700; letter-spacing:0.02em;\n  }\n  .btn-primary{\n    padding:14px 40px; border-radius:30px;\n    background:linear-gradient(135deg, var(--gold-soft), var(--gold));\n    color:#2a2213; font-size:15px;\n    box-shadow:0 8px 22px rgba(201,161,95,0.28);\n  }\n  .btn-primary:active{ transform:scale(0.97); }\n  .btn-ghost{\n    padding:10px 22px; border-radius:24px; background:transparent;\n    border:1px solid var(--line); color:var(--text-dim); font-size:13px;\n  }\n\n  /* ---------- QUESTION FLOW ---------- */\n  .qscreen{ justify-content:space-between; gap:14px; }\n  .progress-row{ display:flex; align-items:center; gap:10px; }\n  .progress-track{ flex:1; height:3px; background:var(--line); border-radius:2px; overflow:hidden; }\n  .progress-fill{ height:100%; background:linear-gradient(90deg, var(--rose), var(--gold-soft)); transition:width .35s ease; }\n  .progress-num{ font-size:11px; color:var(--text-dim); font-variant-numeric:tabular-nums; min-width:44px; text-align:right; }\n  .section-label{ font-size:11px; letter-spacing:.2em; color:var(--rose); text-transform:uppercase; margin-top:2px; }\n\n  .qcard-wrap{ flex:1; display:flex; align-items:center; min-height:0; }\n  .qcard{\n    width:100%; background:var(--paper); color:var(--ink-black); border-radius:18px;\n    padding:26px 22px; box-shadow:0 18px 40px rgba(0,0,0,0.35);\n    display:flex; flex-direction:column; gap:16px; max-height:100%;\n  }\n  .qindex{ font-family:var(--serif); font-size:13px; color:var(--rose); font-weight:700; }\n  .qcard-head{ display:flex; align-items:center; justify-content:space-between; }\n  .done-btn{\n    appearance:none; border:none; background:rgba(0,0,0,0.06); color:var(--ink-black);\n    font-size:12px; font-weight:700; padding:6px 14px; border-radius:16px; cursor:pointer;\n  }\n  .qtext{ font-family:var(--serif); font-size:19px; line-height:1.6; font-weight:600; color:var(--ink-black); }\n  textarea.answer{\n    width:100%; min-height:84px; resize:none; border:none; outline:none;\n    background:var(--paper-soft); border-radius:10px; padding:12px 14px;\n    font-family:var(--sans); font-size:14.5px; line-height:1.7; color:var(--ink-black);\n    border:1px solid rgba(0,0,0,0.06);\n  }\n  textarea.answer::placeholder{ color:rgba(0,0,0,0.32); }\n\n  .nav-row{ display:flex; align-items:center; justify-content:space-between; gap:10px; }\n  .nav-btn{\n    width:46px; height:46px; border-radius:50%; background:rgba(246,239,226,0.06);\n    border:1px solid var(--line); color:var(--paper); font-size:18px;\n    display:flex; align-items:center; justify-content:center;\n  }\n  .nav-btn:disabled{ opacity:.25; }\n  .nav-btn.skip{ width:auto; height:auto; padding:10px 18px; border-radius:22px; font-size:12.5px; color:var(--text-dim); background:transparent; }\n\n  /* ---------- LOADING ---------- */\n  .loading{ align-items:center; justify-content:center; gap:18px; text-align:center; }\n  .seal{\n    width:64px; height:64px; border-radius:50%;\n    border:2px solid var(--gold-soft); position:relative;\n    display:flex; align-items:center; justify-content:center;\n    animation:breathe 1.8s ease-in-out infinite;\n  }\n  .seal::before{ content:\"◈\"; color:var(--gold-soft); font-size:22px; }\n  @keyframes breathe{ 0%,100%{ transform:scale(1); opacity:.7;} 50%{ transform:scale(1.08); opacity:1;} }\n  .loading-text{ font-family:var(--serif); font-size:15px; color:var(--text-dim); }\n\n  /* ---------- REVEAL ---------- */\n  .reveal-scroll{ flex:1; overflow-y:auto; -webkit-overflow-scrolling:touch; padding-bottom:10px; }\n  .reveal-section-title{\n    font-family:var(--serif); font-size:13px; letter-spacing:.15em; color:var(--rose);\n    text-transform:uppercase; margin:22px 0 10px; padding-left:2px;\n  }\n  .reveal-section-title:first-child{ margin-top:0; }\n  .pair-card{\n    background:rgba(246,239,226,0.05); border:1px solid var(--line); border-radius:14px;\n    padding:16px 16px 14px; margin-bottom:12px;\n  }\n  .pair-q{ font-family:var(--serif); font-size:14.5px; color:var(--paper); line-height:1.6; margin-bottom:12px; }\n  .pair-row{ display:flex; gap:10px; margin-bottom:8px; align-items:flex-start; }\n  .pair-avatar{ width:26px; height:26px; border-radius:50%; flex-shrink:0; object-fit:cover; margin-top:2px; background:var(--paper-soft); }\n  .pair-bubble{ flex:1; font-size:13.5px; line-height:1.7; padding:9px 12px; border-radius:10px; }\n  .pair-row.mine .pair-bubble{ background:rgba(217,138,134,0.14); color:#f3d9d7; }\n  .pair-row.his .pair-bubble{ background:rgba(124,138,160,0.16); color:#d9e0ea; }\n  .pair-tag{ font-size:10px; letter-spacing:.1em; opacity:.6; display:block; margin-bottom:3px; }\n\n  .reveal-footer{ display:flex; gap:8px; padding-top:14px; flex-wrap:wrap; }\n  .reveal-footer .btn-ghost{ flex:1; min-width:100px; text-align:center; font-size:12px; padding:10px 8px; }\n  .copy-hint{ text-align:center; font-size:12px; color:var(--gold-soft); padding:6px 0; }\n  .copy-area{\n    width:100%; min-height:120px; margin-top:8px; background:var(--paper); color:var(--ink-black);\n    border-radius:10px; border:none; padding:12px; font-size:12.5px; line-height:1.6; font-family:var(--sans);\n  }\n\n  .error-box{ text-align:center; padding:20px; color:var(--text-dim); font-size:13px; line-height:1.8; }\n\n  ::-webkit-scrollbar{ width:0; height:0; }\n</style>\n</head>\n<body>\n<div class=\"stars\"></div>\n<div id=\"app\"></div>\n\n<script>\n/* ---------- Mock Nuojiji for local/dev testing ---------- */\nif (!window.Nuojiji) {\n  window.Nuojiji = {\n    getUser: async () => ({ id:'dev', nickname:'米米', avatar:'', bio:'' }),\n    getChar: async () => ({ id:'dev_char', name:'橘直哉', avatar:'', description:'事情导向、边界清楚、把关心落地成行动，熟悉后会散漫、嘴硬、带点关西腔。', group:'' }),\n    getCharList: async () => [],\n    ai: async ({messages}) => ({ success:false, error:'mock: 请在糯嘰機 App 内打开以生成回答' }),\n    close: () => {},\n    shareResult: async (r) => ({ shared:false }),\n    aiSummarizeAndSend: async () => ({ success:false, error:'mock' }),\n    pickChars: async () => ({ picked:false, chars:[] }),\n    onGameStateRequest: () => {},\n  };\n}\n\n/* ---------- Data ---------- */\nconst SECTIONS = [\n  { title:\"01｜关于彼此\", qs:[\n    \"第一次见到对方时，对对方的第一印象是什么？\",\n    \"现在回头看，最初的印象和现在有什么不同？\",\n    \"对方身上最容易让你注意到的地方是什么？\",\n    \"对方做什么事情的时候，你会觉得“真的是他/她”？\",\n    \"用三个词形容对方。\",\n    \"如果必须给对方起一个外号，会叫什么？\",\n    \"对方最不像自己的时候是什么样？\",\n    \"有什么事情是你觉得“只有他/她会这样做”的？\",\n  ]},\n  { title:\"02｜日常相处\", qs:[\n    \"两个人谁更容易赖床？\",\n    \"谁更容易忘记吃饭？\",\n    \"谁更容易因为一点小事开心很久？\",\n    \"两个人一起出去，通常是谁决定去哪里？\",\n    \"如果一起迷路了，谁会先拿出手机找地图？\",\n    \"如果两个人都不想说话，会怎么相处？\",\n    \"对方什么时候最需要被放着不管？\",\n    \"对方什么时候明明嘴上说没事，你却知道其实有事？\",\n    \"对方最常做、但自己可能没有意识到的小动作是什么？\",\n    \"如果对方突然说“今天什么都不想做”，你会怎么回应？\",\n  ]},\n  { title:\"03｜只有你知道的事情\", qs:[\n    \"有什么事情是你比其他人更了解对方的？\",\n    \"对方有什么不太愿意承认的小习惯？\",\n    \"你见过对方最狼狈的一次是什么时候？\",\n    \"对方有没有做过一件让你至今记得很清楚的小事？\",\n    \"有什么话对方曾经无意间说过，但你一直记着？\",\n    \"对方什么时候最容易让你心软？\",\n    \"有没有一个瞬间，你突然意识到“这个人对我来说很重要”？\",\n  ]},\n  { title:\"04｜如果发生这些事\", qs:[\n    \"如果对方突然一天没有联系你，你第一反应是什么？\",\n    \"如果对方说“我想一个人待一会儿”，你会怎么做？\",\n    \"如果对方遇到了麻烦却没有告诉你，你会生气吗？为什么？\",\n    \"如果两个人吵架，谁更可能先开口？\",\n    \"如果对方说了一句很伤人的话，但明显不是故意的，你会怎么办？\",\n    \"如果对方突然要离开很长一段时间，你最想对他说/她说什么？\",\n    \"如果只能陪对方度过一天，你会选择怎样的一天？\",\n    \"如果对方半夜突然敲你的门，你觉得最可能发生了什么？\",\n    \"如果对方什么都不说，只是坐在你旁边，你会做什么？\",\n  ]},\n  { title:\"05｜关于“以后”\", qs:[\n    \"你觉得五年后的对方会是什么样？\",\n    \"你觉得五年后的自己会是什么样？\",\n    \"如果以后生活发生很大的变化，你觉得你们还会保持现在的关系吗？\",\n    \"有没有一件事情，你希望以后还能和对方一起做？\",\n    \"如果有一天你们老了，你觉得彼此还会怎么称呼对方？\",\n    \"如果可以把现在的一件东西留到很多年以后，你想留下什么？\",\n  ]},\n  { title:\"06｜最后几题\", qs:[\n    \"对方身上有没有一个你羡慕的地方？\",\n    \"有没有什么事情你觉得对方其实比自己想象中更擅长？\",\n    \"有没有一句平时不太会说，但你确实想对对方说的话？\",\n    \"如果对方现在就在你面前，你最想做什么？\",\n    \"如果只能留下一句话给对方，你会说什么？\",\n  ]},\n  { title:\"Bonus｜互相猜（先不要看对方答案）\", qs:[\n    \"你觉得对方最喜欢你身上的什么？\",\n    \"你觉得对方最担心你的什么？\",\n    \"你觉得对方最舍不得你的什么？\",\n    \"你觉得对方会怎么回答第25题？（有没有一个瞬间，你突然意识到“这个人对我来说很重要”？）\",\n    \"你觉得对方会把你们的关系定义成什么？\",\n  ]},\n];\n\n// 拉平成一个数组，附带 section 索引\nconst FLAT = [];\nSECTIONS.forEach((sec, si) => sec.qs.forEach((q, qi) => FLAT.push({ section: si, sectionTitle: sec.title, text: q, id: FLAT.length })));\n\n/* ---------- State ---------- */\nlet state = {\n  phase: 'intro',      // intro | answering | loading | reveal | error\n  index: 0,\n  myAnswers: new Array(FLAT.length).fill(''),\n  hisAnswers: null,\n  user: { nickname:'我', avatar:'' },\n  char: { name:'对方', avatar:'', description:'' },\n  charPicked: false,\n  errorMsg: '',\n};\n\nconst app = document.getElementById('app');\n\n/* ---------- Render ---------- */\nfunction render() {\n  if (state.phase === 'intro') return renderIntro();\n  if (state.phase === 'answering') return renderQuestion();\n  if (state.phase === 'loading') return renderLoading();\n  if (state.phase === 'reveal') return renderReveal();\n  if (state.phase === 'error') return renderError();\n}\n\nfunction renderIntro() {\n  app.innerHTML = `\n    <div class=\"screen intro\">\n      <div class=\"eyebrow\">Late Night Questionnaire</div>\n      <div class=\"title-main\">今夜的提问<br><span class=\"accent\">给你，也给他</span></div>\n      <div class=\"avatars-row\">\n        <div class=\"avatar-wrap\">\n          <img class=\"avatar-img\" id=\"user-avatar\" src=\"\" alt=\"\">\n          <span class=\"avatar-name\" id=\"user-name\">我</span>\n        </div>\n        <div class=\"connector\"></div>\n        <div class=\"avatar-wrap\">\n          <img class=\"avatar-img\" id=\"char-avatar\" src=\"\" alt=\"\">\n          <span class=\"avatar-name\" id=\"char-name\">对方</span>\n        </div>\n      </div>\n      <div class=\"rules-card\">\n        <b>规则</b><br>\n        两个人分别回答，不要提前偷看对方的答案。<br>\n        可以认真回答，也可以敷衍、吐槽、反悔。<br>\n        共 ${FLAT.length} 题，答完后会一次性生成对方的回答，两边并排揭晓。\n      </div>\n      <button class=\"btn-ghost\" id=\"pick-btn\" style=\"margin-bottom:-6px;\">${state.charPicked ? '换一个角色' : '选择今晚的对方 →'}</button>\n      <button class=\"btn btn-primary\" id=\"start-btn\" ${state.charPicked ? '' : 'disabled style=\"opacity:.4;pointer-events:none;\"'}>开始回答</button>\n    </div>\n  `;\n  document.getElementById('start-btn').onclick = () => { state.phase = 'answering'; render(); };\n  document.getElementById('pick-btn').onclick = () => pickCharacter();\n  loadIdentities();\n}\n\nasync function loadIdentities() {\n  try {\n    const user = await window.Nuojiji.getUser().catch(()=>null);\n    if (user) state.user = { nickname: user.nickname || '我', avatar: user.avatar || '' };\n  } catch(e) {}\n  refreshIntroAvatars();\n}\n\nasync function pickCharacter() {\n  try {\n    const result = await window.Nuojiji.pickChars({ min:1, max:1, title:'选择今晚一起填问卷的角色' });\n    if (result && result.picked && result.chars && result.chars[0]) {\n      const c = result.chars[0];\n      state.char = { name: c.name || '对方', avatar: c.avatar || '', description: c.description || '' };\n      state.charPicked = true;\n    }\n  } catch(e) {}\n  if (state.phase === 'intro') render();\n}\n\nfunction refreshIntroAvatars() {\n  const ua = document.getElementById('user-avatar');\n  const ca = document.getElementById('char-avatar');\n  const un = document.getElementById('user-name');\n  const cn = document.getElementById('char-name');\n  if (ua) ua.src = state.user.avatar || '';\n  if (ca) ca.src = state.char.avatar || '';\n  if (un) un.textContent = state.user.nickname;\n  if (cn) cn.textContent = state.char.name;\n}\n\nfunction renderQuestion() {\n  const item = FLAT[state.index];\n  const pct = Math.round(((state.index+1) / FLAT.length) * 100);\n  app.innerHTML = `\n    <div class=\"screen qscreen\">\n      <div>\n        <div class=\"progress-row\">\n          <div class=\"progress-track\"><div class=\"progress-fill\" style=\"width:${pct}%\"></div></div>\n          <div class=\"progress-num\">${state.index+1} / ${FLAT.length}</div>\n        </div>\n        <div class=\"section-label\">${item.sectionTitle}</div>\n      </div>\n      <div class=\"qcard-wrap\">\n        <div class=\"qcard\">\n          <div class=\"qcard-head\">\n            <div class=\"qindex\">Q${state.index+1}</div>\n            <button class=\"done-btn\" id=\"done-btn\">完成 ✓</button>\n          </div>\n          <div class=\"qtext\">${item.text}</div>\n          <textarea class=\"answer\" id=\"answer-input\" placeholder=\"写点什么…（可以留空跳过）\">${state.myAnswers[state.index]||''}</textarea>\n        </div>\n      </div>\n      <div>\n        <div class=\"nav-row\">\n          <button class=\"nav-btn\" id=\"prev-btn\" ${state.index===0?'disabled':''}>‹</button>\n          <button class=\"nav-btn skip\" id=\"skip-btn\">跳过</button>\n          <button class=\"nav-btn\" id=\"next-btn\">${state.index===FLAT.length-1?'✓':'›'}</button>\n        </div>\n      </div>\n    </div>\n  `;\n  const input = document.getElementById('answer-input');\n  input.addEventListener('input', () => { state.myAnswers[state.index] = input.value; });\n  document.getElementById('done-btn').onclick = () => { input.blur(); };\n  document.getElementById('prev-btn').onclick = () => { if(state.index>0){ state.index--; render(); } };\n  document.getElementById('skip-btn').onclick = () => { goNext(); };\n  document.getElementById('next-btn').onclick = () => { goNext(); };\n}\n\nfunction goNext() {\n  if (state.index < FLAT.length - 1) {\n    state.index++;\n    render();\n  } else {\n    startGeneration();\n  }\n}\n\nfunction renderLoading() {\n  app.innerHTML = `\n    <div class=\"screen loading\">\n      <div class=\"seal\"></div>\n      <div class=\"loading-text\">${state.char.name} 正在落笔…</div>\n    </div>\n  `;\n}\n\nfunction renderError() {\n  app.innerHTML = `\n    <div class=\"screen loading\">\n      <div class=\"error-box\">\n        生成失败了：${state.errorMsg || '未知错误'}<br><br>\n        <button class=\"btn btn-primary\" id=\"retry-btn\">再试一次</button>\n      </div>\n    </div>\n  `;\n  document.getElementById('retry-btn').onclick = () => startGeneration();\n}\n\nasync function startGeneration() {\n  state.phase = 'loading';\n  render();\n\n  const sys = buildSystemPrompt();\n  const userMsg = buildUserPrompt();\n\n  try {\n    const resp = await window.Nuojiji.ai({\n      messages: [\n        { role: 'system', content: sys },\n        { role: 'user', content: userMsg },\n      ],\n      maxTokens: 6000,\n    });\n    if (!resp || !resp.success) {\n      state.errorMsg = (resp && resp.error) || 'API 未配置或调用失败';\n      state.phase = 'error';\n      render();\n      return;\n    }\n    const parsed = parseAiJson(resp.text);\n    if (!parsed) {\n      state.errorMsg = '回答格式解析失败，可以重试一次';\n      state.phase = 'error';\n      render();\n      return;\n    }\n    state.hisAnswers = parsed;\n    state.phase = 'reveal';\n    render();\n  } catch (e) {\n    state.errorMsg = String(e && e.message || e);\n    state.phase = 'error';\n    render();\n  }\n}\n\nfunction buildSystemPrompt() {\n  const desc = state.char.description || '';\n  return [\n    `你正在扮演角色「${state.char.name}」，回答一份由「${state.user.nickname}」发起的双人关系问卷。`,\n    desc ? `角色设定：${desc}` : '',\n    '要求：',\n    '1. 用第一人称、口语化的方式回答，保持角色本身的说话习惯与语气，不要写成正式书面语。',\n    '2. 长度自由，可以一两句话，也可以敷衍、吐槽、反问、沉默（写\"…\"或\"这个不用回答吧\"也可以），不必每题都认真作答，要像真人在深夜随手回一份问卷。',\n    '3. 严格按照下面要求的 JSON 格式输出，不要输出任何多余文字、不要用 markdown 代码块包裹。',\n  ].filter(Boolean).join('\\n');\n}\n\nfunction buildUserPrompt() {\n  const lines = FLAT.map((item, i) => `q${i+1}: ${item.text}`);\n  return [\n    '请依次回答以下问题，输出一个 JSON 对象，key 是 \"q1\" 到 \"q' + FLAT.length + '\"，value 是你的回答（字符串）：',\n    lines.join('\\n'),\n  ].join('\\n\\n');\n}\n\nfunction parseAiJson(text) {\n  if (!text) return null;\n  let t = text.trim();\n  t = t.replace(/^```json\\s*/i, '').replace(/^```\\s*/,'').replace(/```\\s*$/,'');\n  try {\n    const obj = JSON.parse(t);\n    return obj;\n  } catch(e) {\n    const m = t.match(/\\{[\\s\\S]*\\}/);\n    if (m) { try { return JSON.parse(m[0]); } catch(e2) { return null; } }\n    return null;\n  }\n}\n\nfunction renderReveal() {\n  let html = `<div class=\"screen\"><div class=\"reveal-scroll\" id=\"reveal-scroll\">`;\n  SECTIONS.forEach((sec) => {\n    html += `<div class=\"reveal-section-title\">${sec.title}</div>`;\n    sec.qs.forEach((qtext) => {\n      const globalIndex = FLAT.findIndex(f => f.text === qtext && f.sectionTitle === sec.title);\n      const mine = escapeHtml(state.myAnswers[globalIndex] || '（没有回答）');\n      const his = escapeHtml((state.hisAnswers && state.hisAnswers['q'+(globalIndex+1)]) || '（没有回答）');\n      html += `\n        <div class=\"pair-card\">\n          <div class=\"pair-q\">Q${globalIndex+1}. ${escapeHtml(qtext)}</div>\n          <div class=\"pair-row mine\">\n            <img class=\"pair-avatar\" src=\"${state.user.avatar||''}\">\n            <div class=\"pair-bubble\"><span class=\"pair-tag\">${escapeHtml(state.user.nickname)}</span>${mine}</div>\n          </div>\n          <div class=\"pair-row his\">\n            <img class=\"pair-avatar\" src=\"${state.char.avatar||''}\">\n            <div class=\"pair-bubble\"><span class=\"pair-tag\">${escapeHtml(state.char.name)}</span>${his}</div>\n          </div>\n        </div>\n      `;\n    });\n  });\n  html += `\n      <div class=\"copy-hint\" id=\"copy-hint\" style=\"display:none;\"></div>\n      <textarea class=\"copy-area\" id=\"copy-area\" readonly style=\"display:none;\"></textarea>\n      <div class=\"reveal-footer\">\n        <button class=\"btn-ghost\" id=\"copy-btn\">复制全部回答</button>\n        <button class=\"btn-ghost\" id=\"regen-btn\">重新生成</button>\n        <button class=\"btn-ghost\" id=\"restart-btn\">重新开始</button>\n      </div>\n    </div></div>\n  `;\n  app.innerHTML = html;\n  document.getElementById('regen-btn').onclick = () => startGeneration();\n  document.getElementById('restart-btn').onclick = () => {\n    state.phase = 'intro'; state.index = 0; state.myAnswers = new Array(FLAT.length).fill(''); state.hisAnswers = null; state.charPicked = false;\n    render();\n  };\n  document.getElementById('copy-btn').onclick = () => copyAllAnswers();\n}\n\nfunction buildAllAnswersText() {\n  const lines = [`今夜的提问 · ${state.user.nickname} × ${state.char.name}`, ''];\n  SECTIONS.forEach((sec) => {\n    lines.push(`【${sec.title}】`);\n    sec.qs.forEach((qtext) => {\n      const globalIndex = FLAT.findIndex(f => f.text === qtext && f.sectionTitle === sec.title);\n      const mine = state.myAnswers[globalIndex] || '（没有回答）';\n      const his = (state.hisAnswers && state.hisAnswers['q'+(globalIndex+1)]) || '（没有回答）';\n      lines.push(`Q${globalIndex+1}. ${qtext}`);\n      lines.push(`${state.user.nickname}：${mine}`);\n      lines.push(`${state.char.name}：${his}`);\n      lines.push('');\n    });\n  });\n  return lines.join('\\n');\n}\n\nasync function copyAllAnswers() {\n  const text = buildAllAnswersText();\n  const hint = document.getElementById('copy-hint');\n  const area = document.getElementById('copy-area');\n  try {\n    await navigator.clipboard.writeText(text);\n    hint.style.display = 'block';\n    hint.textContent = '已复制到剪贴板 ✓';\n    area.style.display = 'none';\n  } catch (e) {\n    // 沙盒环境剪贴板 API 可能被拦截，退回手动选择复制\n    area.value = text;\n    area.style.display = 'block';\n    area.focus();\n    area.select();\n    hint.style.display = 'block';\n    hint.textContent = '自动复制失败，长按下方文本框选择\"全选\"再\"复制\"即可';\n  }\n}\n\nfunction escapeHtml(str) {\n  return String(str).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\n}\n\ndocument.addEventListener('DOMContentLoaded', () => { setupViewportFix(); render(); });\nif (document.readyState !== 'loading') { setupViewportFix(); render(); }\n\nfunction setupViewportFix() {\n  if (!window.visualViewport) return;\n  const vv = window.visualViewport;\n  const el = document.getElementById('app');\n  const onResize = () => {\n    el.style.height = vv.height + 'px';\n  };\n  vv.addEventListener('resize', onResize);\n  vv.addEventListener('scroll', onResize);\n  onResize();\n}\n</script>\n</body>\n</html>\n","usesAI":true,"entryKind":"game","requestedPermissions":[],"requestedNet":{"domains":[]},"requestedSlots":[],"chrome":"auto","sourceLocked":false,"permissions":[],"slots":[],"appId":"app_mu9p09c7uz06","version":"1.0.0","cspMode":"strict","createdAt":1789901278287,"id":2,"htmlRef":null}]