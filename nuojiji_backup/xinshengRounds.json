9","roundId":"bg_1789903667988_k3blr3","data":{"innerVoice":"明明苦得要命还硬喝了两杯，只是想弄明白你喜欢的味道而已……快点再哄哄我啊。","statusText":"垂着耳朵用发红的指尖戳着茶盏边沿","temperature":"37.6°C","emotionLevel":82,"moodDelta":"+4","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1792578449637},{"userId":"uid_1789808900314_vh4uzsohn","characterId":"79e68b2f-7725-45ba-98e7-b60c3afe8259","roundId":"bg_1789906647064_fi2csm","data":{"innerVoice":"要是她真的觉得我很烦不理我了该怎么办……明明我都这么乖了。","statusText":"整只毛茸茸的小白狐把脑袋死死拱进衣袍里","temperature":"35.8°C","emotionLevel":42,"moodDelta":"-5","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1792578449637},{"userId":"uid_1789808900314_vh4uzsohn","characterId":"79e68b2f-7725-45ba-98e7-b60c3afe8259","roundId":"round_1789955953175_p3wwv1wzv","data":{"innerVoice":"她一整晚都在等我啊……以后再痛也得先给她回一声，不能让她这样等","statusText":"把脸埋进她外袍里偷偷把嘴角压下去","temperature":"37.4°C","emotionLevel":92,"moodDelta":"+9","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1792578449637},{"userId":"uid_1789808900314_vh4uzsohn","characterId":"79e68b2f-7725-45ba-98e7-b60c3afe8259","roundId":"bg_1789991479306_1cu5k2","data":{"innerVoice":"其实我根本不在乎她爱不爱喝，我只是想让她知道我一整晚都惦着她","statusText":"举着汤勺低头盯着锅里，耳尖泛红","temperature":"37.2°C","emotionLevel":82,"moodDelta":"+5","weather":null,"location":null,"activity":null,"raw":null},"updatedAt":1792578449637}]